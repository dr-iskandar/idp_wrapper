# Optional fallback key for OpenAI. You can also save provider API keys from AI Gateway.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Optional. If omitted, the MVP generates data/.master.key on first boot.
# For server deployment set this to a stable secret or base64 32-byte key.
APP_MASTER_KEY=

OLLAMA_BASE_URL=http://localhost:11434
PORT=3000
